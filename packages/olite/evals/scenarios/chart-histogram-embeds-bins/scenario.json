{
  "name": "chart: a binned histogram embeds the rows it computed",
  "description": "Tier 2. Histogram bins in Python, so rows behind a URL would no longer match the encoding. Guards the rule that only untransformed rows may be referenced.",
  "tier": 2,
  "inputs": [
    "Show me the distribution of Glucose in this history as a histogram."
  ],
  "timeoutMs": 180000,
  "assertions": {
    "events": {
      "mustInclude": [
        "turn_start"
      ]
    },
    "messages": {
      "repliesInChat": true
    },
    "toolCalls": {
      "mustInclude": [
        {
          "name": "vintent_dataset",
          "argsContains": {
            "dataset_id": "$staged:health.csv"
          }
        }
      ]
    },
    "artifacts": {
      "mustInclude": [
        {
          "kind": "vega-lite",
          "embedsRows": true,
          "mark": "bar",
          "encodes": [
            "bin_label"
          ]
        }
      ]
    }
  },
  "dataset": {
    "file": "health.csv",
    "history": "charting session"
  }
}
