{
  "name": "chart: a grouped bar chart over a categorical column",
  "description": "Tier 2. Aggregation over a text column, exercising shell selection on a non-numeric field rather than the numeric default.",
  "tier": 2,
  "inputs": [
    "Compare average Glucose by Obesity in this history as a bar chart, using vintent."
  ],
  "timeoutMs": 180000,
  "assertions": {
    "events": {
      "mustInclude": [
        "turn_start"
      ]
    },
    "messages": {
      "repliesInChat": true
    },
    "toolCalls": {
      "mustInclude": [
        {
          "name": "vintent_dataset",
          "argsContains": {
            "dataset_id": "$staged:health.csv"
          }
        }
      ]
    },
    "artifacts": {
      "mustInclude": [
        {
          "kind": "vega-lite",
          "mark": "bar",
          "encodes": [
            "Obesity",
            "Glucose"
          ]
        }
      ]
    },
    "budget": {
      "maxSteps": 25,
      "maxRepeatedCall": 3
    }
  },
  "dataset": {
    "file": "health.csv",
    "history": "charting session"
  }
}
