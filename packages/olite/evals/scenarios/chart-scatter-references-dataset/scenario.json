{
  "name": "chart: a scatter references the dataset instead of copying it",
  "description": "Tier 2. Scatter encodes columns straight from the file, so the spec must carry a URL and no rows: the case a Galaxy page benefits from.",
  "tier": 2,
  "inputs": [
    "Plot Glucose against BMI in this history as a scatter plot."
  ],
  "timeoutMs": 180000,
  "assertions": {
    "events": {
      "mustInclude": [
        "turn_start"
      ]
    },
    "messages": {
      "repliesInChat": true
    },
    "toolCalls": {
      "mustInclude": [
        {
          "name": "vintent_dataset",
          "argsContains": {
            "dataset_id": "$staged:health.csv"
          }
        }
      ]
    },
    "artifacts": {
      "mustInclude": [
        {
          "kind": "vega-lite",
          "referencesDataset": true,
          "datasetId": "$staged:health.csv",
          "encodes": [
            "Glucose",
            "BMI"
          ],
          "mark": "point"
        }
      ]
    }
  },
  "dataset": {
    "file": "health.csv",
    "history": "charting session"
  }
}
