{
    "name": "@galaxyproject/warc",
    "version": "0.0.0",
    "description": "Explore WARC records with the National Library of Norway's WARC Explorer.",
    "type": "module",
    "license": "MIT",
    "files": [
        "static"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "npm run test:unit && npm run build && npm run test:e2e",
        "test:unit": "node --test tests/*.test.js",
        "test:e2e": "playwright test",
        "prettier": "prettier --write package.json index.html playwright.config.js vite.config.js \"src/**/*.{js,css}\" \"tests/*.js\""
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "prettier": "^3.9.10",
        "vite": "^8.1.5"
    }
}
