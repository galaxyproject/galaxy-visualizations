{
    "name": "@galaxyproject/varri",
    "version": "0.0.0",
    "type": "module",
    "description": "Galaxy visualization for vaRRI - visual annotation of RNA-RNA interactions",
    "license": "MIT",
    "files": [
        "static"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prettier": "prettier --write 'package.json' 'main.js' 'test.spec.js'",
        "preview": "vite preview",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "npm run build && node --test tests/*.test.mjs",
        "test:e2e": "npx playwright test",
        "test:update": "npx playwright test --update-snapshots"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "prettier": "^3.5.3",
        "varri-js": "^1.0.2",
        "vite": "^6.2.2",
        "vite-plugin-static-copy": "^3.1.4"
    }
}
