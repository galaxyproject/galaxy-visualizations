{
    "name": "@galaxyproject/jupyterlite",
    "version": "0.0.30",
    "type": "module",
    "files": [
        "static"
    ],
    "scripts": {
        "build": "vite build && npm run build:jupyter && npm run build:gxy && npm run build:extension && npm run build:index && npm run build:public",
        "build:extension": "node jl.install.js",
        "build:gxy": "cd gxy && python -m build --wheel",
        "build:index": "mkdir -p static/dist && cp src/index.js static/dist",
        "build:jupyter": "jupyter lite build --output-dir static/dist/_output",
        "build:public": "cp public/* static",
        "dev": "jupyter lite serve --output-dir static/dist/_output --config static/dist/_output/jupyter-lite.json",
        "prettier": "prettier --write 'package.json' '*.js' '*.ts' 'src/*.js' 'src/*.ts'",
        "test": "npx playwright test"
    },
    "devDependencies": {
        "@jupyterlab/application": "^4.6.3",
        "@jupyterlab/apputils": "^4.6.3",
        "@playwright/test": "^1.52.0",
        "node-fetch": "^3.3.2",
        "playwright": "^1.52.0",
        "prettier": "^3.5.3",
        "typescript": "^5.4.2",
        "vite": "^7.1.14"
    },
    "overrides": {
        "sanitize-html": "^2.17.7"
    }
}
