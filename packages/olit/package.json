{
  "name": "@galaxyproject/olit",
  "version": "0.0.2",
  "type": "module",
  "license": "MIT",
  "files": [
    "static"
  ],
  "scripts": {
    "build": "npm run build:pyodide && npm run build:skills && vite build",
    "build:pyodide": "node scripts/install_pyodide.js",
    "build:skills": "node scripts/install_skills.js",
    "dev": "npm run build && vite",
    "galaxy-mcp-docs": "python3 scripts/capture_galaxy_mcp_docs.py",
    "lint:js": "prettier --config ./prettier.config.js --check './*.{js,ts,json}' 'src/**/*.{js,ts,json,css}'",
    "lint:scripts": "python3 -m black --check --line-length 120 scripts && ruff check --line-length 120 scripts",
    "prettier": "prettier --config ./prettier.config.js --write './*.{js,ts,json}' 'src/**/*.{js,ts,json,css}'",
    "preview": "vite preview",
    "stale": "node scripts/check_stale.js",
    "test": "npm run test:unit && npm run lint:scripts && npm run lint:js && npm run typecheck && npm run vendored && npm run test:e2e",
    "test:e2e": "bash e2e/run-all.sh",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "vendored": "python3 scripts/check_vendored.py",
    "build:session": "npm run build:pyodide && npm run build:skills && vite build --config vite.config.session.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.2",
    "@earendil-works/pi-ai": "^1.0.2",
    "@galaxyproject/galaxy-ops": "https://github.com/guerler/galaxy-mcp/releases/download/ops-v0.3.2-ops.1/galaxyproject-galaxy-ops-0.3.2-ops.1.tgz",
    "galaxy-charts": "^0.1.17",
    "mermaid": "^11.16.1",
    "vega": "^5.30.0",
    "vega-embed": "^6.26.0",
    "vega-lite": "^5.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "dompurify": "^3.4.1",
    "galaxy-charts-xml-parser": "^1.0.3",
    "happy-dom": "^20.0.11",
    "marked": "^18.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "pyodide": "^0.29.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.16"
  }
}
